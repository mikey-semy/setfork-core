# Та же Postgres, что у sethub-app (Next). Скопируй в .env и подставь значения.
DATABASE_URL=postgresql://user:password@localhost:5439/dbname
# Размер пула соединений Postgres (по умолчанию 10).
# PGPOOL_MAX=10
# Адрес gRPC-сервера git-ядра (по умолчанию 127.0.0.1:50051)
# SETFORK_CORE_ADDR=127.0.0.1:50051

# Rate-limit per-метод, запросов в минуту (0 = выключить). Тяжёлые методы
# (git-мутации/merge/bundle/Create/AddVersion) — отдельный бюджет.
# SETFORK_RPC_RPM=600
# SETFORK_RPC_RPM_HEAVY=60

# ── Наблюдаемость ─────────────────────────────────────────────────────
# HTTP-порт метрик Prometheus (/metrics); '0' или 'off' — выключить.
# SETFORK_METRICS_ADDR=127.0.0.1:9464
# Уровень логов (tracing EnvFilter), дефолт info. Пример: debug или setfork_core=debug
# RUST_LOG=info
# JSON-логи для сборщиков (по умолчанию человекочитаемый формат).
# SETFORK_LOG_JSON=1

# ОБЯЗАТЕЛЬНО: общий Bearer-токен канала Next↔ядро. Ядро НЕ делает пользовательской
# авторизации — токен канала это единственная граница доступа ко всему контенту. Без
# него ядро не стартует (fail-closed): открытый канал = полный обход владения/модерации.
# Тот же токен задать фронту (SETFORK_CORE_TOKEN). Сгенерировать: openssl rand -hex 32
SETFORK_CORE_TOKEN=
# Локальный dev без токена — только с явным опт-аутом (канал БЕЗ авторизации, localhost):
# SETFORK_ALLOW_INSECURE=1
# ОБЯЗАТЕЛЬНО: общий с фронтом том персистентных bare-репо (git = источник правды).
# У Next дефолт — <frontend>/.setfork-git; здесь укажи ТОТ ЖЕ путь (в проде — общий том).
GIT_DATA_DIR=/data/setfork-git

# ── Бэкап git-тома → S3 (docker-compose.dokploy.yml, сервис git-backup) ─
# git = источник правды по контенту; единственный хост → бэкап обязан быть offsite.
# offen/docker-volume-backup ждёт ХОСТ S3 БЕЗ схемы (в отличие от медийного S3_ENDPOINT).
# Можно тот же бакет Selectel, что у медиа фронта (креды здесь — отдельные записи).
BACKUP_S3_ENDPOINT_HOST=        # напр. s3.ru-3.storage.selcloud.ru (без https://)
# BACKUP_S3_ENDPOINT_PROTO=https
BACKUP_S3_BUCKET=               # бакет для бэкапов (пусто → git-backup не пишет в S3)
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# BACKUP_S3_GIT_PREFIX=setfork/git
# BACKUP_GIT_CRON=30 3 * * *
BACKUP_KEEP_DAYS=14
